# Compose 本地环境文件示例：复制为 compose.local.env 后填入真实值（该文件不入库）。
# 密码请自行随机生成；SESSION_SECRET 为随机 32 字节 hex（64 个字符），过短后端拒绝启动。
# Docker 启动：cp compose.local.env.example compose.local.env && docker compose up -d --build

# 巡检员账号（inspector）密码
INSPECTOR_PASSWORD=[REDACTED: 本地演示密码]

# 管理员账号（admin）密码
ADMIN_PASSWORD=[REDACTED: 本地演示密码]

# 会话密钥（HMAC 派生会话令牌摘要用）
SESSION_SECRET=[REDACTED: 随机 64 位 hex 会话密钥]

# 开发快捷登录：默认关闭；本地演示需要一键登录时设为 1（生产请勿开启）
QUICK_LOGIN_ENABLED=1
