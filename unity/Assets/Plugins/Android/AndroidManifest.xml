<?xml version="1.0" encoding="utf-8"?>
<!--
  自定义 Main Manifest：标准路径下的本文件启用 Player Settings 中的
  Custom Main Manifest；取消勾选时 Unity 会将文件重命名为 .DISABLED。
  相机权限与 ARCore 的 uses-feature / meta-data 由 ARCore XR 插件的库 Manifest
  在 Gradle 合并时自动加入，此处不重复声明，避免重复条目。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 局域网访问电脑后端（HTTP 明文）需要网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+（targetSdk>=30）侧载应用查询 ARCore 可用性必须声明包可见性，
         否则运行时报 UNKNOWN_ERROR（见 docs/真机ARCore可行性验证报告.md） -->
    <queries>
        <package android:name="com.google.ar.core" />
    </queries>

    <!-- networkSecurityConfig 引用 Plugins/Android/res/xml/ 下的明文放行配置（联调 http:// 后端）
         enableOnBackInvokedCallback=false：Android 13+ 仍把系统返回键/边缘返回手势交给 Activity 的
         传统返回事件，Unity 以 Escape 键送达 AndroidBackHandler；本期不使用预测性返回回调 -->
    <application android:networkSecurityConfig="@xml/network_security_config"
                 android:enableOnBackInvokedCallback="false">
        <activity android:name="com.unity3d.player.UnityPlayerActivity"
                  android:theme="@style/UnityThemeSelector"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
        </activity>
    </application>
</manifest>
